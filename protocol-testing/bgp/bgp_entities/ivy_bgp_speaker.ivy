#lang ivy1.7

include order
include bgp_infer
include file
include bgp_shim
include random_value

# Speaker B (primary tester leg; was bgp_ivy_instance pre-Phase-C)
parameter speaker_b_addr : ip.addr = 0x0a000001 # 0x7f000001
parameter speaker_b_id   : bgp_id = 0x0a000001
parameter speaker_b_as   : as_number = 1

# Speaker C (added in Phase C for RFC 4271 §6.8 3-speaker collision topology)
parameter speaker_c_addr : ip.addr = 0x0a000002
parameter speaker_c_id   : bgp_id = 0x0a000002
parameter speaker_c_as   : as_number = 1

# Speaker A / impl (FRR or other IUT)
parameter speaker_impl_addr : ip.addr = 0x0a000003 # 0x7f000001
parameter speaker_impl_id   : bgp_id = 0x0a000003
parameter speaker_impl_as   : as_number = 2

# Three speaker instances: tester legs B+C, IUT impl A.
instance bgp_ivy_instance_b : bgp_speaker.speaker(speaker_b_addr,speaker_b_id,speaker_b_as)
instance bgp_ivy_instance_c : bgp_speaker.speaker(speaker_c_addr,speaker_c_id,speaker_c_as)
instance bgp_impl_instance  : bgp_speaker.speaker(speaker_impl_addr,speaker_impl_id,speaker_impl_as)
