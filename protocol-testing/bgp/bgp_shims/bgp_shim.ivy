relation isup(A:ip.addr)
function getsock(A:ip.addr) : net.socket
relation pend(A:ip.addr)

# Relations default to false in Ivy — explicit init over bv[32] compiles to a 4B-iteration loop
# after init {
#     isup(A) := false;
#     pend(A) := false;
# }

# TCP transport for BGP peering [rfc4271:8.1]
implement net.connected(src:endpoint_id, s:net.socket) {
    var bid := net_ep_to_bgpid(src);
    call show_connected(bid,s);
    pend(bgpid_to_other_endpoint(bid)) := false;
    isup(bgpid_to_other_endpoint(bid)) := true; # [rfc4271:8.1]
    isup(bgpid_to_endpoint(bid))       := true;
}

import action show_connected(src:bgp_id, s:net.socket)

