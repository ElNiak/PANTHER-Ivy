#lang ivy1.7

include bgp_type

# BGP Connection Finite State Machine [rfc4271:8]

object bgp_connection_state = {
    type this = {idle, connect, active, open_sent, open_confirm, established}
}

# Per-speaker connection state [rfc4271:8.2.1]
function conn_state(C:bgp_id) : bgp_connection_state

after init {
    conn_state(C) := bgp_connection_state.idle;
}

# Idle -> OpenSent on TCP success [rfc4271:8.2.2]
# Collapses Idle -> Connect -> OpenSent (ConnectRetryTimer deferred)
after net.connected {
    var bid := net_ep_to_bgpid(self);
    if conn_state(bid) = bgp_connection_state.idle {
        conn_state(bid) := bgp_connection_state.open_sent;
    }
}

# Idle -> OpenSent on incoming TCP accept [rfc4271:8.2.2]
after net.accept {
    var bid := net_ep_to_bgpid(self);
    if conn_state(bid) = bgp_connection_state.idle {
        conn_state(bid) := bgp_connection_state.open_sent;
    }
}

# OPEN valid when either side is in OpenSent [rfc4271:8.2.2]
# Disjunctive: src=local sending OR dst=local receiving
before bgp_open_message_event {
    require conn_state(src) = bgp_connection_state.open_sent
          | conn_state(dst) = bgp_connection_state.open_sent;
}

# OpenSent -> OpenConfirm on receiving OPEN [rfc4271:8.2.2]
after bgp_open_message_event {
    if conn_state(dst) = bgp_connection_state.open_sent {
        conn_state(dst) := bgp_connection_state.open_confirm;
    }
}

# KEEPALIVE valid when either side is in OpenConfirm or Established [rfc4271:8.2.2]
before bgp_keepalive_message_event {
    require conn_state(src) = bgp_connection_state.open_confirm
          | conn_state(src) = bgp_connection_state.established
          | conn_state(dst) = bgp_connection_state.open_confirm
          | conn_state(dst) = bgp_connection_state.established;
}

# OpenConfirm -> Established on receiving KEEPALIVE [rfc4271:8.2.2]
after bgp_keepalive_message_event {
    if conn_state(dst) = bgp_connection_state.open_confirm {
        conn_state(dst) := bgp_connection_state.established;
    }
}

# UPDATE valid when either side is in Established [rfc4271:9]
before bgp_update_message_event {
    require conn_state(src) = bgp_connection_state.established
          | conn_state(dst) = bgp_connection_state.established;
}

# NOTIFICATION -> both peers to Idle [rfc4271:8.2.2]
after bgp_notification_message_event {
    conn_state(src) := bgp_connection_state.idle;
    conn_state(dst) := bgp_connection_state.idle;
}

# HoldTimer expiry -> Idle [rfc4271:8.2.2]
# (hold_timer_expired action defined in bgp_time.ivy)
after hold_timer_expired {
    conn_state(src) := bgp_connection_state.idle;
}

# FSM guards for timer actions (avoid circular include with bgp_time.ivy)
before hold_timer_expired {
    require conn_state(src) = bgp_connection_state.open_sent
          | conn_state(src) = bgp_connection_state.open_confirm
          | conn_state(src) = bgp_connection_state.established;
}

before keepalive_timer_expired {
    require conn_state(src) = bgp_connection_state.open_confirm
          | conn_state(src) = bgp_connection_state.established;
}
