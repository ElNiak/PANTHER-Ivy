#lang ivy1.7

include bgp_type

# BGP Connection Finite State Machine [rfc4271:8]

object bgp_connection_state = {
    type this = {idle, connect, active, open_sent, open_confirm, established}
}

# Per-connection state, keyed by (local, remote) bgp_id pair [rfc4271:8.2.1]
# Generalized from conn_state(C:bgp_id) to support RFC 4271 §6.8 collision
# detection (Scenario 1: OpenConfirm with multiple peers; Scenario 2:
# Established collision handled ephemerally inside collision_detect action).
function conn_state(C:bgp_id, D:bgp_id) : bgp_connection_state

after init {
    conn_state(C, D) := bgp_connection_state.idle;
}

# Idle -> OpenSent on TCP success [rfc4271:8.2.2]
# Collapses Idle -> Connect -> OpenSent (ConnectRetryTimer deferred)
# Both sides transition: the local speaker and the remote peer,
# since the IUT behind Docker doesn't trigger a separate callback.
after net.connected {
    var bid := net_ep_to_bgpid(self);
    var remote := bgpid_to_other_bgpid(bid);
    if conn_state(bid, remote) = bgp_connection_state.idle {
        conn_state(bid, remote) := bgp_connection_state.open_sent;
    };
    if conn_state(remote, bid) = bgp_connection_state.idle {
        conn_state(remote, bid) := bgp_connection_state.open_sent;
    }
}

# Idle -> OpenSent on incoming TCP accept [rfc4271:8.2.2]
# Both sides transition: the acceptor (self) and the remote peer (other),
# since net.connected doesn't fire for the IUT behind Docker.
after net.accept {
    var bid := net_ep_to_bgpid(self);
    var remote := net_ep_to_bgpid(other);
    if conn_state(bid, remote) = bgp_connection_state.idle {
        conn_state(bid, remote) := bgp_connection_state.open_sent;
    };
    if conn_state(remote, bid) = bgp_connection_state.idle {
        conn_state(remote, bid) := bgp_connection_state.open_sent;
    }
}

# OPEN valid in OpenSent or OpenConfirm [rfc4271:8.2.2]
# OpenConfirm needed because FRR sends OPEN before the tester generates Ivy's
# Dual-purpose event: src/dst semantics flip between send and recv paths
# (see feedback_ivy_event_semantics), so guards use disjunctive (src,dst)|(dst,src).
before bgp_open_message_event {
    require true; # [rfc4271:8.2.1]
    require conn_state(src, dst) = bgp_connection_state.open_sent
          | conn_state(src, dst) = bgp_connection_state.open_confirm
          | conn_state(dst, src) = bgp_connection_state.open_sent
          | conn_state(dst, src) = bgp_connection_state.open_confirm;
}

# OpenSent -> OpenConfirm on receiving OPEN [rfc4271:8.2.2]
# Augmented with §6.8 Collision Detection [rfc4271:6.8]:
#   - §6.8.1-3 OpenConfirm collision: delegate to collision_detect /
#     collision_resolved (declared above).
#   - §6.8.4 Established collision: original session preserved; the new
#     TCP leg's Cease assertion lives in bgp_speaker_test_collision.ivy
#     (the model has no separate slot for the transient leg).
# Capture the prior state so the OpenConfirm-collision branch only fires
# on a genuine collision, not a just-promoted-from-OpenSent state.
after bgp_open_message_event {
    require true; # [rfc4271:8.2.2:opensent]
    var prior := conn_state(dst, src);
    if prior = bgp_connection_state.open_sent {
        conn_state(dst, src) := bgp_connection_state.open_confirm;
    };
    if prior = bgp_connection_state.open_confirm {
        # §6.8.2 higher-ID-wins: thread loser through so the test spec at C6
        # can assert which leg received NOTIFICATION Cease per §6.8.5.
        var loser := collision_detect(dst, src);
        var peer:bgp_id;
        if loser = dst {
            peer := src;
        } else {
            peer := dst;
        };
        call collision_resolved(loser, peer);
    };
    if prior = bgp_connection_state.established {
        # §6.8.4 no-op: preserve Established. Test spec asserts wire Cease.
    }
}

# RFC 4271 §6.8 BGP Connection Collision Detection [rfc4271:6.8]
#
# §6.8.1 close-one: speakers MUST close one of the colliding connections.
# §6.8.2 higher-ID-wins: the connection initiated by the speaker with the
#   higher BGP Identifier is preserved; lower-ID speaker MUST close.
# §6.8.3 scan-all-OpenConfirm: speaker MUST scan every OpenConfirm session
#   to detect the collision (N=2 witness in bgp_speaker_test_collision.ivy
#   scenario 1 exercises two OpenConfirm peers simultaneously).
# §6.8.5 NOTIFICATION Cease: closing the losing connection MUST send a
#   NOTIFICATION with Error Code Cease (test asserts on the wire pcap).
#
# Closing here mirrors the NOTIFICATION pattern at lines 94-97 of this file
# (drive both directions of conn_state to idle). C2 wires these helpers
# into the OPEN handler.

action collision_detect(local_id:bgp_id, new_remote:bgp_id) returns (loser:bgp_id) = {
    require conn_state(local_id, new_remote) = bgp_connection_state.open_confirm;
    # §6.8.2 higher-ID-wins: lower bgp_id loses. Total order via bgp_id_lt
    # (declared with axioms in bgp_type.ivy) avoids the bv[32] enumeration
    # cost of `<` on an interpreted type.
    if bgp_id_lt(local_id, new_remote) {
        loser := local_id;
    } else {
        loser := new_remote;
    };
}

action collision_resolved(loser:bgp_id, peer:bgp_id) = {
    require conn_state(loser, peer) = bgp_connection_state.open_confirm
          | conn_state(loser, peer) = bgp_connection_state.established;
    # Match NOTIFICATION-Cease pattern at lines 94-97: drive both sides idle.
    conn_state(loser, peer) := bgp_connection_state.idle;
    conn_state(peer, loser) := bgp_connection_state.idle;
}

# KEEPALIVE valid when either side is in OpenConfirm or Established [rfc4271:8.2.2]
before bgp_keepalive_message_event {
    require conn_state(src, dst) = bgp_connection_state.open_confirm
          | conn_state(src, dst) = bgp_connection_state.established
          | conn_state(dst, src) = bgp_connection_state.open_confirm
          | conn_state(dst, src) = bgp_connection_state.established;
}

# OpenConfirm -> Established on receiving KEEPALIVE [rfc4271:8.2.2]
after bgp_keepalive_message_event {
    require true; # [rfc4271:8.2.2:openconfirm]
    if conn_state(dst, src) = bgp_connection_state.open_confirm {
        conn_state(dst, src) := bgp_connection_state.established;
    }
}

# UPDATE valid when either side is in Established [rfc4271:9]
before bgp_update_message_event {
    require true; # [rfc4271:9]
    require conn_state(src, dst) = bgp_connection_state.established
          | conn_state(dst, src) = bgp_connection_state.established;
}

# NOTIFICATION -> both peers to Idle [rfc4271:8.2.2]
after bgp_notification_message_event {
    conn_state(src, dst) := bgp_connection_state.idle;
    conn_state(dst, src) := bgp_connection_state.idle;
}

# HoldTimer expiry -> Idle for all of src's connections [rfc4271:8.2.2]
# (hold_timer_expired action defined in bgp_time.ivy, signature: (src:bgp_id))
# Timer is per-speaker, so expiry drops ALL of src's sessions; the unbound D
# in the assignment is universally quantified.
after hold_timer_expired {
    conn_state(src, D) := bgp_connection_state.idle;
}

# FSM guards for timer actions (avoid circular include with bgp_time.ivy).
# Timer-running gate lives in bgp_time.ivy:61 (hold_timer_running(src)) and
# bgp_time.ivy:74 (keepalive_timer_running(src)); those guards already ensure
# the timer only fires when an active connection exists, so the FSM-layer
# state check is redundant and is relaxed to `require true` under 2-arity.
before hold_timer_expired {
    require true; # [rfc4271:8.2.2:holdtimer] -- state check via bgp_time.ivy:61
}

before keepalive_timer_expired {
    require true; # [rfc4271:10] -- state check via bgp_time.ivy:74
}
