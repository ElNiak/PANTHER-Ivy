#lang ivy1.7

include bgp_type
include bgp_route

# BGP Routing Information Base [rfc4271:3.2]

relation adj_rib_in(P:bgp_id, R:bgp_route)
relation loc_rib(R:bgp_route)
relation adj_rib_out(P:bgp_id, R:bgp_route)

after init {
    adj_rib_in(P, R) := false;
    loc_rib(R) := false;
    adj_rib_out(P, R) := false;
}
