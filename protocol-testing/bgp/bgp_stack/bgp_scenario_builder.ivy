#lang ivy1.7

# BGP scenario builder — deterministic message construction for Z3 [rfc4271:4.3]
#
# Z3 picks a scenario from a finite enum (update_scenario -> bv[3]); this
# module constructs the full message deterministically. Eliminates per-test
# solver hints for array-based constraints (NLRI, AS_PATH segments).
#
# Soundness:
# - The builder calls the original handle actions (origin/as_path/next_hop),
#   so their around blocks fire and populate path_attr_size + queued_path_attr.
# - The builder calls bgp_update_message_event, so its around block fires
#   and triggers all monitors and serialization.
# - Receive-side validation in bgp_update_message.ivy is preserved by the
#   `if ~_generating` guard added in Task 2.

include bgp_scenario

# ── UPDATE Builder ──────────────────────────────────────────────

action generate_update(src:bgp_id, dst:bgp_id, scen:update_scenario)

implement generate_update {
    # FSM preconditions — the only thing Z3 must solve [rfc4271:8.2.2:established]
    require conn_state(src, dst) = bgp_connection_state.established;
    require open_message_recv(src) & open_message_recv(dst);
    require src = bgp_ivy_instance_b.bgpid;
    require dst = bgp_impl_instance.bgpid;

    # Reset attr-present flags and queued state so handles see a clean slate
    origin_present(src) := false;
    as_path_present(src) := false;
    next_hop_present(src) := false;
    queued_path_attr(src) := path_attr.arr.empty;
    num_queued_path_attr(src) := 0;
    path_attr_size(src) := 0;

    if scen = announce_single {
        call _build_announce_single(src, dst);
    };
    if scen = announce_multihop {
        call _build_announce_multihop(src, dst);
    };
    if scen = replace_route {
        call _build_replace_route(src, dst);
    };
    # withdraw_single needs no path-attribute handles — per [rfc4271:4.3]:
    # "An UPDATE message might advertise only routes that are to be
    # withdrawn from service, in which case the message will not include
    # path attributes or Network Layer Reachability Information."
    # Reset above already cleared path_attr state; nothing more to queue.

    # Construct the UPDATE message from the populated state
    var msg : bgp_update_message;
    msg.withdraw_routes_len := 0;
    msg.withdraw_routes := withdraw_route.arr.empty;
    msg.total_path_attr_len := path_attr_size(src);
    msg.path_attrs := queued_path_attr(src);
    msg.network_layer_reach_infos.len := 0;
    msg.network_layer_reach_infos.route_prefix := stream_data.empty;

    if scen = announce_single {
        # NLRI=192.168.1.0/24 [rfc4271:4.3]
        msg.network_layer_reach_infos.len := 24;
        var route_bytes : stream_data;
        route_bytes := stream_data.empty;
        route_bytes := route_bytes.append(192);
        route_bytes := route_bytes.append(168);
        route_bytes := route_bytes.append(1);
        msg.network_layer_reach_infos.route_prefix := route_bytes;
    };
    if scen = announce_multihop {
        # NLRI=10.0.0.0/24 — distinct prefix from announce_single so FRR's
        # RIB has a separate entry per scenario. [rfc4271:4.3]
        msg.network_layer_reach_infos.len := 24;
        var mh_bytes : stream_data;
        mh_bytes := stream_data.empty;
        mh_bytes := mh_bytes.append(10);
        mh_bytes := mh_bytes.append(0);
        mh_bytes := mh_bytes.append(0);
        msg.network_layer_reach_infos.route_prefix := mh_bytes;
    };
    if scen = withdraw_single {
        # Withdraw 192.168.1.0/24 [rfc4271:4.3]
        # Wire encoding per §4.3: <length=24 bits, prefix=[192,168,1]>
        # = 1 octet length + 3 octets prefix = 4 octets total.
        # "Withdrawn Routes Length ... indicates the total length of the
        # Withdrawn Routes field in octets." So wr_len_field = 4.
        var wr : withdraw_route;
        wr.len := 24;
        var wr_bytes : stream_data;
        wr_bytes := stream_data.empty;
        wr_bytes := wr_bytes.append(192);
        wr_bytes := wr_bytes.append(168);
        wr_bytes := wr_bytes.append(1);
        wr.route_prefix := wr_bytes;
        var wr_arr : withdraw_route.arr;
        wr_arr := withdraw_route.arr.empty;
        wr_arr := wr_arr.append(wr);
        msg.withdraw_routes := wr_arr;
        msg.withdraw_routes_len := 4;
        # NLRI stays empty (already set above) — withdraw-only message.
    };
    if scen = replace_route {
        # Same NLRI=192.168.1.0/24 as announce_single, but with differing
        # path attributes (ORIGIN=INCOMPLETE instead of IGP) to exercise
        # implicit-withdraw / route-replace semantics [rfc4271:9.1.2]:
        # "If the route is learned from an external peer, the local BGP
        # speaker MUST replace the NEXT_HOP attribute and the MED attribute
        # of the existing route with the values of the corresponding
        # attributes of the newly received route..."
        msg.network_layer_reach_infos.len := 24;
        var rr_bytes : stream_data;
        rr_bytes := stream_data.empty;
        rr_bytes := rr_bytes.append(192);
        rr_bytes := rr_bytes.append(168);
        rr_bytes := rr_bytes.append(1);
        msg.network_layer_reach_infos.route_prefix := rr_bytes;
    };

    # Fire the original event — around block validates and after block tracks
    call bgp_update_message_event(src, dst, msg);
}

# ── Private scenario helpers ───────────────────────────────────

action _build_announce_single(src:bgp_id, dst:bgp_id)

implement _build_announce_single {
    # ORIGIN=IGP (0) [rfc4271:5.1.1]
    var origin_attr : path_attr.origin;
    origin_attr.transitive := true;
    origin_attr.optional := false;
    origin_attr.partial := false;
    origin_attr.value := 0;
    call path_attr.origin.handle(origin_attr, src, dst, bgp_message_type.update_mess);

    # AS_PATH = [AS_SEQUENCE: speaker_b_as] — single-call API, parameter-only requires
    var own_as : autonomous_system;
    own_as.id := speaker_b_as;
    var as_list : autonomous_system.arr;
    as_list := autonomous_system.arr.empty;
    as_list := as_list.append(own_as);
    call commit_as_sequence(src, dst, as_list, true, false, false);

    # NEXT_HOP [rfc4271:5.1.3]
    var next_hop_attr : path_attr.next_hop;
    next_hop_attr.transitive := true;
    next_hop_attr.optional := false;
    next_hop_attr.partial := false;
    next_hop_attr.next_hop := bgp_impl_instance.ep.addr;
    call path_attr.next_hop.handle(next_hop_attr, src, dst, bgp_message_type.update_mess);
}

# ── announce_multihop ──────────────────────────────────────────
#
# Simulates Ivy propagating a route it previously learned from an upstream
# peer (AS 65001), which in turn learned from AS 65002. Per [rfc4271:5.1.2]:
#   "When a given BGP speaker advertises the route to an external peer, the
#    advertising speaker updates the AS_PATH attribute as follows:
#    1) if the first path segment of the AS_PATH is of type AS_SEQUENCE, the
#       local system prepends its own AS number as the last element of the
#       sequence (put it in the leftmost position with respect to the
#       position of octets in the protocol message)."
# So Ivy (AS 1) prepends its own AS to the inherited sequence, yielding the
# wire AS_PATH = [AS_SEQUENCE: 1, 65001, 65002] (Ivy first, then upstream).

action _build_announce_multihop(src:bgp_id, dst:bgp_id)

implement _build_announce_multihop {
    # ORIGIN=IGP (0) — same rationale as announce_single. [rfc4271:5.1.1]
    var origin_attr : path_attr.origin;
    origin_attr.transitive := true;
    origin_attr.optional := false;
    origin_attr.partial := false;
    origin_attr.value := 0;
    call path_attr.origin.handle(origin_attr, src, dst, bgp_message_type.update_mess);

    # AS_PATH = [AS_SEQUENCE: 1, 65001, 65002] — Ivy prepended own AS per
    # [rfc4271:5.1.2:b:1]. 3 ASes fits in 2-octet encoding (all <65536), so
    # no AS_TRANS / RFC 6793 handling needed. Single-call API, param-only requires.
    var own_as : autonomous_system;
    own_as.id := speaker_b_as;
    var up1 : autonomous_system;
    up1.id := 65001;
    var up2 : autonomous_system;
    up2.id := 65002;
    var as_list : autonomous_system.arr;
    as_list := autonomous_system.arr.empty;
    as_list := as_list.append(own_as);
    as_list := as_list.append(up1);
    as_list := as_list.append(up2);
    call commit_as_sequence(src, dst, as_list, true, false, false);

    # NEXT_HOP = Ivy tester's wire interface IP [rfc4271:5.1.3]
    var next_hop_attr : path_attr.next_hop;
    next_hop_attr.transitive := true;
    next_hop_attr.optional := false;
    next_hop_attr.partial := false;
    next_hop_attr.next_hop := bgp_impl_instance.ep.addr;
    call path_attr.next_hop.handle(next_hop_attr, src, dst, bgp_message_type.update_mess);
}

# ── replace_route ──────────────────────────────────────────────
#
# Re-advertises the same NLRI as announce_single (192.168.1.0/24) but with a
# different ORIGIN attribute (INCOMPLETE=2 instead of IGP=0). Exercises
# implicit-withdraw / route-replace semantics in the IUT's Adj-RIB-In
# per [rfc4271:9.1.2]: "If the route is learned from an external peer,
# the local BGP speaker MUST replace the NEXT_HOP attribute and the MED
# attribute of the existing route with the values of the corresponding
# attributes of the newly received route..." Same AS_PATH and NEXT_HOP
# keep the diff focused on ORIGIN semantics.

action _build_replace_route(src:bgp_id, dst:bgp_id)

implement _build_replace_route {
    # ORIGIN=INCOMPLETE (2) [rfc4271:5.1.1]
    # Per [rfc4271:5.1.1]: "INCOMPLETE - Network Layer Reachability
    # Information learned by some other means."  Distinct from
    # announce_single's IGP=0 so the IUT sees a genuine attribute change.
    var origin_attr : path_attr.origin;
    origin_attr.transitive := true;
    origin_attr.optional := false;
    origin_attr.partial := false;
    origin_attr.value := 2;
    call path_attr.origin.handle(origin_attr, src, dst, bgp_message_type.update_mess);

    # AS_PATH = [AS_SEQUENCE: speaker_b_as] — identical to announce_single.
    # Per [rfc4271:5.1.2] the originating speaker includes its own AS in
    # AS_SEQUENCE when advertising to an external peer. Single-call API.
    var own_as : autonomous_system;
    own_as.id := speaker_b_as;
    var as_list : autonomous_system.arr;
    as_list := autonomous_system.arr.empty;
    as_list := as_list.append(own_as);
    call commit_as_sequence(src, dst, as_list, true, false, false);

    # NEXT_HOP = Ivy tester's wire interface IP [rfc4271:5.1.3]
    var next_hop_attr : path_attr.next_hop;
    next_hop_attr.transitive := true;
    next_hop_attr.optional := false;
    next_hop_attr.partial := false;
    next_hop_attr.next_hop := bgp_impl_instance.ep.addr;
    call path_attr.next_hop.handle(next_hop_attr, src, dst, bgp_message_type.update_mess);
}
