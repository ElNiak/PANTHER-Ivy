#lang ivy1.7

# RFC 4271 §6.8 BGP Connection Collision Detection — 3-speaker test spec.
#
# Topology: FRR=A=bgp_impl_instance, tester legs B=bgp_ivy_instance_b and
# C=bgp_ivy_instance_c. Two scenarios exercised non-deterministically:
#
# Scenario 1 (OpenConfirm collision, MUSTs 6.8.1/2/3/5):
#   B and C both connect to A and reach OpenConfirm. A receives a new OPEN
#   from B. A scans every OpenConfirm session (N=2 witness for §6.8.3) and
#   uses §6.8.2 higher-ID-wins to pick the loser. Loser's leg goes idle;
#   winner's session preserved. NOTIFICATION Cease emitted on the loser leg
#   (asserted via wire pcap).
#
# Scenario 2 (Established collision, MUSTs 6.8.4/5):
#   B and A reach Established (KEEPALIVE exchanged). A receives a new OPEN
#   from B. §6.8.4 closes the new connection regardless of bgp_id; the
#   original Established session is preserved. NOTIFICATION Cease emitted on
#   the new leg (asserted via wire pcap).

include order
include file
include bgp_shim
include ivy_bgp_speaker_behavior

relation slept_bgp

after init {
    # Historical single-leg deployment note (kept for git-blame context):
    # This test originally only opened the B↔A TCP socket. C leg's
    # connect_accept was omitted because the Docker bridge allocated only
    # one IP per container and C's static bgp_id IP (0x0a000002) was not
    # on any local interface, so §6.8.1-3 OpenConfirm-collision could
    # not be exercised non-trivially.
    #
    # §6.8.3 follow-up — UNBLOCKED by Path α (2026-05-01):
    # The auxiliary-network mechanism in panther's docker_compose plugin
    # now puts the C-leg IP (10.0.0.2) on a second NIC of the ivy_tester
    # container via the panther_aux_network bridge. To exercise "examine
    # all OpenConfirm connections" (RFC 4271 §6.8.3) non-trivially, add a
    # second `connect_accept(endpoint_id.ivy_speaker_c, endpoint_id.impl_speaker, ...)`
    # call after the line below, targeting the C leg's secondary IP.
    # Cross-reference: outer-worktree memory `bgp-collision-c-leg-connect-accept.md`.
    #
    # §6.8.4 (Established collision via reconnect) was already exercisable
    # in the single-leg deployment and remains so.
    getsock(bgp_impl_instance.ep.addr) := net.connect_accept(endpoint_id.ivy_speaker, endpoint_id.impl_speaker, bgp_impl_instance.ep.addr);
    pend(bgp_impl_instance.ep.addr) := true;
    slept_bgp := false;
}


before bgp_open_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_open_message){
    if _generating {

    }
}

before bgp_update_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_update_message){
    if _generating {
    }
}

before bgp_keepalive_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_keepalive_message){
    if _generating {

    }
}

before bgp_notification_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_notification_message){
    if _generating {

    }
}

export bgp_open_message_event
export bgp_update_message_event
export bgp_keepalive_message_event
export bgp_notification_message_event
export path_attr.origin.handle
export path_attr.as_path.handle
export path_attr.next_hop.handle

# §6.8 success conditions for both scenarios:
# - The IUT (impl/A) is in Established or Idle (not stuck mid-handshake).
# - At least one tester leg reached OPEN exchange with the impl.
# - For Scenario 2: if conn_state(impl, B)=established, then it stays
#   established after a colliding new OPEN (§6.8.4). The model's
#   `after bgp_open_message_event` no-op branch enforces this by construction.
# - For Scenario 1: collision_resolved drove the losing leg to idle.
#   §6.8.5 NOTIFICATION Cease assertion lives in the wire pcap analysis,
#   not in this Ivy invariant — the model has no separate slot for the
#   transient TCP leg.
export action _finalize = {
    require conn_state(bgp_impl_instance.bgpid, bgp_ivy_instance_b.bgpid) = bgp_connection_state.established
          | conn_state(bgp_impl_instance.bgpid, bgp_ivy_instance_b.bgpid) = bgp_connection_state.idle;
    require conn_state(bgp_impl_instance.bgpid, bgp_ivy_instance_c.bgpid) = bgp_connection_state.established
          | conn_state(bgp_impl_instance.bgpid, bgp_ivy_instance_c.bgpid) = bgp_connection_state.idle;
    require open_message_recv(bgp_impl_instance.bgpid); # [rfc4271:4.2]
    require ~received_unexpected_notification; # [rfc4271:6]
}
