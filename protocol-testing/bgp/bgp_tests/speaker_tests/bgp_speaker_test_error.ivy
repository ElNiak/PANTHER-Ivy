#lang ivy1.7

# BGP Error Handling Test [rfc4271:6]
#
# Tests the IUT's response to error conditions:
# 1. Establish a BGP session (OPEN + KEEPALIVE exchange)
# 2. Tester sends a NOTIFICATION with Cease error code [rfc4271:6.7]
# 3. Verify the IUT transitions both peers to Idle [rfc4271:8.2.2]
#
# Connection mode: accept (Ivy initiates TCP, waits for IUT OPEN)

include order
include file
include bgp_shim
include ivy_bgp_speaker_behavior

relation slept_bgp
relation notification_sent

after init {
    getsock(bgp_impl_instance.ep.addr) := net.connect_accept(endpoint_id.ivy_speaker, endpoint_id.impl_speaker, bgp_impl_instance.ep.addr);
    pend(bgp_impl_instance.ep.addr) := true;
    slept_bgp := false;
    notification_sent := false;
    acceptable_error(bgp_error_code.cease_error) := true;
    acceptable_error(bgp_error_code.header_mess_error) := true;
    acceptable_error(bgp_error_code.fsm_error) := true;
}

before bgp_open_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_open_message){
    if _generating {

    }
}

before bgp_update_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_update_message){
    if _generating {
    }
}

before bgp_keepalive_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_keepalive_message){
    if _generating {

    }
}

before bgp_notification_message_event(src:bgp_id,dst:bgp_id,bgp_message:bgp_notification_message){
    if _generating {
        require bgp_message.error_code = bgp_error_code.cease_error; # [rfc4271:6.7]
    }
}

after bgp_notification_message_event {
    if _generating {
        notification_sent := true;
    }
}

export bgp_open_message_event
export bgp_update_message_event
export bgp_keepalive_message_event
export bgp_notification_message_event
export hold_timer_expired
export keepalive_timer_expired
export path_attr.origin.handle
export path_attr.as_path.handle
export path_attr.next_hop.handle

export action _finalize = {
    # After the test, verify that:
    # 1. The session was established at some point (OPEN was received)
    # 2. The session ended in Idle (NOTIFICATION caused teardown) or stayed Established
    require open_message_recv(bgp_impl_instance.bgpid); # [rfc4271:4.2]
    require conn_state(bgp_impl_instance.bgpid) = bgp_connection_state.idle
          | conn_state(bgp_impl_instance.bgpid) = bgp_connection_state.established;
}
