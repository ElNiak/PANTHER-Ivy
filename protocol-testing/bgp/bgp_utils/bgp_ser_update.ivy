<<< impl

    class `bgp_ser_update` : public ivy_binary_ser_128 {
        enum bgp_state {bgp_s_wr_len,
              bgp_s_wr,
              bgp_s_wr_l,
              bgp_s_wr_prefix,
              bgp_s_path_len,
              bgp_s_path_attr,
              bgp_s_path_attr_len,


              bgp_s_path_attr_origin,
              bgp_s_path_attr_as_path,

              bgp_s_path_attr_as_path_segment_type,
              bgp_s_path_attr_as_path_segment_len,
              bgp_s_path_attr_as_path_segment_value,

              bgp_s_path_attr_next_hop,
              bgp_s_path_attr_multi_exit_disc,
              bgp_s_path_attr_local_pref,
              bgp_s_path_attr_atomic_aggregate,
              bgp_s_path_attr_aggregator,
              bgp_s_path_attr_aggregator_ip_addr,

              bgp_s_net_info,
              bgp_s_net_info_pref,

              bgp_s_attr_flag_optional,
              bgp_s_attr_flag_transitive,
              bgp_s_attr_flag_partial} state;
        int token_length = 4;
        long path_attr_type;
        int fence=0;
        int current_bgp_size = 0;
        int payload_length = 12;

        int withdraw_routes_len = 0;
        int route_prefix_len = 0;
        int total_path_attr_len = 0;
        int segment_len = 0;
        int route_prefix_len_2 = 0;
        int attr_len = 0;

        bool optional_bit = false; //first order bit
        bool transitive_bit = false; //second order bit
        bool partial_bit = false; //third order bit
        bool extended_length_bit = false; //fourth order bit

        int debug = 0;

        int next_state = 0;
        enum bgp_state saved_attr_payload_state = bgp_s_path_attr;



    public:
        bgp_ser_update() : state(bgp_s_wr_len) {
        }
        virtual void  set(int128_t res) {
            switch (state) {
            case bgp_s_wr_len:
            {
                std::cerr << "bgp_s_wr_len 1\n";
                setn(res,2);
                withdraw_routes_len = res;
                std::cerr << "withdraw_routes_len = " << withdraw_routes_len << "\n";
                state = bgp_s_wr_l;
            }
            break;
            case bgp_s_wr_l:
            {
                std::cerr << "bgp_s_wr_l 1\n";
                setn(res,1);
                route_prefix_len = res;
                std::cerr << "route_prefix_len = " << route_prefix_len << "\n";
                state = bgp_s_wr_prefix;
            }
            break;
            case bgp_s_wr_prefix:
            {
                std::cerr << "bgp_s_wr_prefix 1\n";
                setn(res,1);
            }
            break;
            case bgp_s_wr:
            {
                std::cerr << "bgp_s_wr 1\n";
                setn(res,1);
                std::cerr << "payload_length = " << payload_length << "\n";
                //state = bgp_s_path_len;
            }
            break;
            case bgp_s_path_len:
            {
                std::cerr << "bgp_s_path_len 1\n";
                setn(res,2);
                total_path_attr_len = res;
                state = bgp_s_path_attr;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            }
            break;
            case bgp_s_path_attr:
            {
                std::cerr << "bgp_s_path_attr 1\n";
            }
            break;
            case bgp_s_path_attr_len:
            {
                int128_t len_res;
                std::cerr << "bgp_s_path_attr_len 1\n";
                int get = 1;
                if(extended_length_bit)
                    get = 2;
                setn(len_res,get); //ivy_binary_deser_128::
                attr_len = len_res;
                total_path_attr_len -= get;
                std::cerr << "attr_len = " << attr_len << "\n";

                state = (enum bgp_state) next_state;
                std::cerr << "state = " << state << "\n";
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            }
            break;
            case bgp_s_path_attr_origin:
            {
                std::cerr << "bgp_s_path_attr_origin 1\n";
                setn(res,1);
                total_path_attr_len -= 1;
                debug = res;
                std::cerr << "debug = " << debug << "\n";
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_as_path:
            {
                std::cerr << "bgp_s_path_attr_as_path 1\n";
                state = bgp_s_path_attr_as_path_segment_type;
            };
            break;
            case bgp_s_path_attr_as_path_segment_len:
            {
                std::cerr << "bgp_s_path_attr_as_path_segment_len 1\n";
                setn(res,1);
                segment_len = res;
                total_path_attr_len -= 1;
                attr_len -= 1;
                state = bgp_s_path_attr_as_path_segment_value;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_as_path_segment_type:
            {
                std::cerr << "bgp_s_path_attr_as_path_segment_type 1\n";
                setn(res,1);
                total_path_attr_len -= 1;
                attr_len -= 1;
                state = bgp_s_path_attr_as_path_segment_len;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_as_path_segment_value:
            {
                std::cerr << "bgp_s_path_attr_as_path_segment_value 1\n";
                setn(res,2);
                total_path_attr_len -= 2;
                attr_len -= 2;
            };
            break;
            case bgp_s_path_attr_next_hop:
            {
                std::cerr << "bgp_s_path_attr_next_hop 1\n";
                setn(res,4);
                total_path_attr_len -= 4;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_multi_exit_disc:
            {
                std::cerr << "bgp_s_path_attr_multi_exit_disc 1\n";
                setn(res,4);
                total_path_attr_len -= 4;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_local_pref:
            {
                std::cerr << "bgp_s_path_attr_local_pref 1\n";
                setn(res,4);
                total_path_attr_len -= 4;
            };
            break;
            case bgp_s_path_attr_atomic_aggregate:
            {
                std::cerr << "bgp_s_path_attr_atomic_aggregate 1\n";
            };
            break;
            case bgp_s_path_attr_aggregator:
            {
                std::cerr << "bgp_s_path_attr_aggregator 1\n";
                setn(res,2);
                total_path_attr_len -= 2;
                state = bgp_s_path_attr_aggregator_ip_addr;
                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
            };
            break;
            case bgp_s_path_attr_aggregator_ip_addr:
            {
                std::cerr << "bgp_s_path_attr_aggregator_ip_addr 1\n";
                setn(res,4);
                total_path_attr_len -= 4;
            };
            break;
            case bgp_s_net_info:
            {
                std::cerr << "bgp_s_net_info 1\n";
                setn(res,1);
                route_prefix_len_2 = res;
                state = bgp_s_net_info_pref;
                std::cerr << "route_prefix_len_2 = " << route_prefix_len_2 << "\n";
            }
            break;
            case bgp_s_net_info_pref:
            {
                std::cerr << "bgp_s_net_info_pref 1\n";
                if(route_prefix_len_2-1 > 0)
                setn(res,1);
                route_prefix_len_2 -= 8; //todo prefix is ip prefix, here we only support multiple of 8
            }
            break;
            case bgp_s_attr_flag_optional:
            {
                // Consume bool from struct, don't write — flag byte already in open_tag
                state = bgp_s_attr_flag_transitive;
            }
            break;
            case bgp_s_attr_flag_transitive:
            {
                state = bgp_s_attr_flag_partial;
            }
            break;
            case bgp_s_attr_flag_partial:
            {
                state = saved_attr_payload_state;
            }
            break;
            default:
                std::cerr << "bgp_deser_update 3\n";
                throw deser_err();
            }
        }

        //Function that return true if the i bit of the byte is 1
        bool checkBit(int byte, int i) {
            // Shift 1 to the i-th position and perform bitwise AND with the byte
            // If the result is non-zero, then the i-th bit is 1, otherwise, it's 0
            return (byte & (1 << i)) != 0;
        }

        //Function that return true if the i bit of the byte is 1
        //TODO
        bool setBit(int byte, int i) {
            // Shift 1 to the i-th position and perform bitwise AND with the byte
            // If the result is non-zero, then the i-th bit is 1, otherwise, it's 0
            return (byte & (1 << i)) != 0;
        }

       // Serialization path: Ivy calls open_tag(int, string) with the variant tag
        virtual void open_tag(int tag, const std::string &name) {
             if (state == bgp_s_path_attr) {
                path_attr_type = tag;
                std::cerr << "ser open_tag path_attr_type = " << path_attr_type << "\n";

                // RFC 4271 Section 5: Flags (1 byte), then Type Code (1 byte)
                int flag_values[] = {0x40, 0x40, 0x40, 0x80, 0x40, 0x40, 0xC0};
                int128_t flag_byte = (tag >= 0 && tag <= 6) ? flag_values[tag] : 0x40;
                setn(flag_byte, 1);

                // Attribute type code (1 byte): Ivy tag 0=ORIGIN(1), 1=AS_PATH(2), 2=NEXT_HOP(3), etc.
                int128_t type_code = tag + 1;
                setn(type_code, 1);

                // Write attribute length (1 byte) — computed from type
                int attr_lengths[] = {1, 0, 4, 4, 4, 0, 6}; // origin, as_path(var), next_hop, med, local_pref, atomic_agg, aggregator
                int128_t computed_len = (tag >= 0 && tag <= 6) ? attr_lengths[tag] : 0;
                setn(computed_len, 1);
                attr_len = computed_len;
                std::cerr << "ser attr_len = " << attr_len << "\n";

                if (tag == 0) { saved_attr_payload_state = bgp_s_path_attr_origin; state = bgp_s_attr_flag_optional; return; }
                if (tag == 1) { saved_attr_payload_state = bgp_s_path_attr_as_path_segment_type; state = bgp_s_attr_flag_optional; return; }
                if (tag == 2) { saved_attr_payload_state = bgp_s_path_attr_next_hop; state = bgp_s_attr_flag_optional; return; }
                if (tag == 3) { saved_attr_payload_state = bgp_s_path_attr_multi_exit_disc; state = bgp_s_attr_flag_optional; return; }
                if (tag == 4) { saved_attr_payload_state = bgp_s_path_attr_local_pref; state = bgp_s_attr_flag_optional; return; }
                if (tag == 5) { saved_attr_payload_state = bgp_s_path_attr_atomic_aggregate; state = bgp_s_attr_flag_optional; return; }
                if (tag == 6) { saved_attr_payload_state = bgp_s_path_attr_aggregator; state = bgp_s_attr_flag_optional; return; }
            }
            std::cerr << "ser open_tag unhandled state=" << state << " tag=" << tag << "\n";
        }

       // Deserialization path: reads variant tag from stream
       virtual int open_tag(const std::vector<std::string> &tags) {
             if (state == bgp_s_path_attr) {
                int128_t ft;
                setn(ft,1);
                path_attr_type = ft;
                std::cerr << "ser path_attr_type = " << path_attr_type << "\n";

                // RFC 4271 Section 5 flag bytes per attribute class [rfc4271:5:transitive] [rfc4271:5:partial]
                // Well-known mandatory/discretionary: 0x40, Optional non-transitive: 0x80, Optional transitive: 0xC0
                int flag_values[] = {0x40, 0x40, 0x40, 0x80, 0x40, 0x40, 0xC0};
                int128_t flag_byte = (path_attr_type >= 0 && path_attr_type <= 6)
                    ? flag_values[path_attr_type] : 0x40;
                setn(flag_byte, 1);
                std::cerr << "ser flag_byte = " << (int)flag_byte << "\n";

                total_path_attr_len -= 1;

                int128_t len_res;
                std::cerr << "bgp_s_path_attr_len 1\n";
                extended_length_bit = false;
                int get = 1;
                if(extended_length_bit)
                    get = 2;
                setn(len_res,get);
                attr_len = len_res;
                std::cerr << "attr_len = " << attr_len << "\n";
                total_path_attr_len -= 1;
                std::cerr << "attr_len = " << attr_len << "\n";

                std::cerr << "total_path_attr_len = " << total_path_attr_len << "\n";
                if (path_attr_type == 0) {
                    saved_attr_payload_state = bgp_s_path_attr_origin;
                    state = bgp_s_attr_flag_optional;
                    std::cerr << "state = " << bgp_s_path_attr_origin << "\n";
                    return 0x01;
                }
                if (path_attr_type == 1) {
                    saved_attr_payload_state = bgp_s_path_attr_as_path_segment_type;
                    state = bgp_s_attr_flag_optional;
                    return 0x02;
                }
                if (path_attr_type == 2) {
                    saved_attr_payload_state = bgp_s_path_attr_next_hop;
                    state = bgp_s_attr_flag_optional;
                    return 0x03;
                }
                if (path_attr_type == 3) {
                    saved_attr_payload_state = bgp_s_path_attr_multi_exit_disc;
                    state = bgp_s_attr_flag_optional;
                    return 0x04;
                }
                if (path_attr_type == 4) {
                    saved_attr_payload_state = bgp_s_path_attr_local_pref;
                    state = bgp_s_attr_flag_optional;
                    return 0x05;
                }
                if (path_attr_type == 5) {
                    saved_attr_payload_state = bgp_s_path_attr_atomic_aggregate;
                    state = bgp_s_attr_flag_optional;
                    return 0x06;
                }
                if (path_attr_type == 6) {
                    saved_attr_payload_state = bgp_s_path_attr_aggregator;
                    state = bgp_s_attr_flag_optional;
                    return 0x07;
                }
                //std::cerr << "saw tag " << ft << "\n";
            }
            std::cerr << "state          = " << state << "\n";
            std::cerr << "bgp_deser_update 2\n";
            throw deser_err();
        }

         virtual void open_list_elem() {
            std::cerr << "ser open_list_elem state=" << state << "\n";
            if (state == bgp_s_path_attr_as_path_segment_type) {
                std::cerr << "ser open_list_elem: as_path_segment_type\n";
                return;
            }
            if (state == bgp_s_wr_l) {
                std::cerr << "ser open_list_elem: wr_l\n";
                return;
            }
            if (state == bgp_s_wr_prefix) {
                std::cerr << "ser open_list_elem: wr_prefix route_prefix_len=" << route_prefix_len << " withdraw_routes_len=" << withdraw_routes_len << "\n";
                route_prefix_len -= 1;
                withdraw_routes_len -= 1;
                return;
            }
            if (state == bgp_s_path_attr) {
                std::cerr << "ser open_list_elem: path_attr\n";
                return;
            }
            if (state == bgp_s_path_attr_as_path_segment_value) {
                std::cerr << "ser open_list_elem: as_path_segment_value total_path_attr_len=" << total_path_attr_len << "\n";
                total_path_attr_len -= 1;
                return;
            }
            if (state == bgp_s_net_info_pref || state == bgp_s_net_info) {
                std::cerr << "ser open_list_elem: net_info\n";
                return;
            }
            if (state == bgp_s_wr_len) {
                return;
            }
            std::cerr << "ser open_list_elem: unhandled state=" << state << "\n";
        }

        void open_list(int len) {
            // Override base class: do NOT write array length to output.
            // BGP UPDATE format handles field boundaries via the state machine.
        }
        void close_list() {
            std::cerr << "closing list state=" << state << "\n";
            if (state == bgp_s_wr_l) {
                state = bgp_s_path_len;
            }
            if (state == bgp_s_wr_prefix) {
                if (route_prefix_len == 0) {
                    if(withdraw_routes_len == 0){
                        state = bgp_s_path_len;
                    }
                    else{
                        state = bgp_s_wr_l;
                    }
                }
            }
            if (state == bgp_s_path_attr) {
                state = bgp_s_net_info;
            }
            if(state == bgp_s_path_attr_as_path_segment_value){
                std::cerr << "state == bgp_s_path_attr_as_path_segment_value "<< segment_len << " " << total_path_attr_len <<"\n";
                if (segment_len <= 0) {
                    if(total_path_attr_len == 0){ //TODO
                        state = bgp_s_net_info;
                    }
                    else{
                        state = bgp_s_path_attr_as_path_segment_value;
                    }
                }
            }
        }
        void close_list_elem() {}

        virtual void close_tag() {
            std::cerr << "closing tag\n";
            if(state == bgp_s_net_info_pref)
            state = bgp_s_net_info_pref;
            else
            state = bgp_s_path_attr;
        }

        ~bgp_ser_update(){}
    };

>>>
