#lang ivy1.7

#    BGP Identifier
#       A 4-octet unsigned integer that indicates the BGP Identifier of
#       the sender of BGP messages.  A given BGP speaker sets the value of
#       its BGP Identifier to an IP address assigned to that BGP speaker.
#       The value of the BGP Identifier is determined upon startup and is
#       the same for every local interface and BGP peer. [rfc4271:1.1]
# bv[32] grounds the < ordering used by collision_detect at bgp_fsm.ivy:112
# for §6.8.2 higher-ID-wins arbitration.
type bgp_id

# §6.8.2 higher-ID-wins arbitration needs a total order on bgp_id without
# concrete enumeration: `interpret bgp_id -> bv[32]` would force the Ivy
# compiler to emit 4B-iteration loops over the bv[32] domain in the C++
# test driver. Instead, declare a relation with total-order axioms — Z3
# reasons symbolically over the 3 concrete instances (B, C, A) used at
# runtime, no enumeration loops emitted.
relation bgp_id_lt(X:bgp_id, Y:bgp_id)
axiom forall X:bgp_id. ~bgp_id_lt(X, X)
axiom forall X:bgp_id, Y:bgp_id. bgp_id_lt(X, Y) | bgp_id_lt(Y, X) | X = Y
axiom forall X:bgp_id, Y:bgp_id, Z:bgp_id. bgp_id_lt(X, Y) & bgp_id_lt(Y, Z) -> bgp_id_lt(X, Z)

# The type `version` represents a protocol version as a 8-bit unsigned number.

type version

#  This 2-octet unsigned integer indicates the Autonomous System number of the sender.

type as_number

type microseconds
type seconds
interpret seconds -> bv[16]
type milliseconds

# This 16-octet field is included for compatibility; it MUST be set to all ones.
type marker_id
interpret marker_id -> longbv[1][16][16]

# AS_PATH segment type: 1-octet field (1=AS_SET, 2=AS_SEQUENCE) [rfc4271:5.1.2]
type segmenttype
interpret segmenttype -> bv[8]

# iBGP (same AS) vs eBGP (different AS) peering [rfc4271:5.1.2]
object peer_type = {
    type this = {ibgp, ebgp}
}



type prefix
# interpret prefix -> stream_data
