{
  "version": 3,
  "standard_library": "ivy/include/1.7",
  "scope_detection": "auto",
  "protocol_id": "coap",
  "workspace_root_offset": "../..",
  "workspace_layers": [
    {
      "id": "coap",
      "include_paths": [
        "protocol-testing/coap"
      ],
      "priority": 10
    }
  ],
  "exclude_paths": [
    "doc",
    "examples",
    "test",
    "notebooks",
    "patches",
    "submodules",
    "ivy"
  ]
}
