#lang ivy1.7

include order
include coap_file
include ivy_coap_shim_client
include ivy_coap_client_behavior

after init {
    call time_api.c_timer.start;
}

after init {
    sock := net.open(endpoint_id.client,client.ep);
    client.set_tls_id(0);
    server.set_tls_id(1);
}

export coap_message_event
export client_send_event

export action _finalize = {
    #
}
